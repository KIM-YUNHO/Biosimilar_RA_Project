", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "This is a representation of an electronic record that was signed electronically. Following this are manifestations of any and all electronic signatures for this electronic record.", "status": "kept", "furniture": false, "section_path": ["ENCLOSURE(S):"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/46", "parent": "#/body", "page": 4, "bbox": [50.0, 674.9, 509.5, 688.8], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "--------------------------------------------------------------------------------------------", "status": "kept", "furniture": false, "section_path": ["ENCLOSURE(S):"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/47", "parent": "#/body", "page": 4, "bbox": [50.0, 657.5, 62.7, 668.6], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "/s/", "status": "kept", "furniture": false, "section_path": ["ENCLOSURE(S):"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/48", "parent": "#/body", "page": 4, "bbox": [50.0, 643.1, 289.8, 654.2], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "------------------------------------------------------------", "status": "kept", "furniture": false, "section_path": ["ENCLOSURE(S):"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/49", "parent": "#/body", "page": 4, "bbox": [50.0, 593.1, 181.4, 618.6], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "TATIANA OUSSOVA 07/15/2026 11:28:23 AM", "status": "kept", "furniture": false, "section_path": ["ENCLOSURE(S):"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/50", "parent": "#/body", "page": 4, "bbox": [5.5, 7.2, 92.7, 15.7]