4", "parent": "#/body", "page": 4, "bbox": [50.0, 692.9, 501.0, 742.8], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "This is a representation of an electronic record that was signed electronically. Following this are manifestations of any and all electronic signatures for this electronic record.", "status": "kept", "furniture": false, "section_path": ["ENCLOSURE:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/45", "parent": "#/body", "page": 4, "bbox": [50.0, 674.9, 509.5, 688.8], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "--------------------------------------------------------------------------------------------", "status": "kept", "furniture": false, "section_path": ["ENCLOSURE:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/46", "parent": "#/body", "page": 4, "bbox": [50.0, 657.5, 62.7, 668.6], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "/s/", "status": "kept", "furniture": false, "section_path": ["ENCLOSURE:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/47", "parent": "#/body", "page": 4, "bbox": [50.0, 643.1, 289.8, 654.2], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "------------------------------------------------------------", "status": "kept", "furniture": false, "section_path": ["ENCLOSURE:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/48", "parent": "#/body", "page": 4, "bbox": [50.0, 593.1, 181.4, 618.6], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "TATIANA OUSSOVA 11/07/2019 12:45:41 PM", "status": "kept", "furniture": false, "section_path": ["ENCLOSURE:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/t