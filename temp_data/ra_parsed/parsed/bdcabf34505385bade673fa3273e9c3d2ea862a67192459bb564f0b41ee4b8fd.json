{"document_id": 166, "sha256": "bdcabf34505385bade673fa3273e9c3d2ea862a67192459bb564f0b41ee4b8fd", "agency": "fda", "doc_type": "approval_letter", "program_id": "ABP654", "engine": "prep-1.4+docling2.137.0+tables-accurate+repair1+pictables1", "watermarks_removed": 0, "routes": [{"page": 1, "route": "DIGITAL", "reason": "chars=1145"}, {"page": 2, "route": "DIGITAL", "reason": "chars=2613"}, {"page": 3, "route": "DIGITAL", "reason": "chars=1717"}, {"page": 4, "route": "DIGITAL", "reason": "chars=422"}, {"page": 5, "route": "DIGITAL", "reason": "chars=526"}], "blocks": [{"type": "picture", "ref": "#/pictures/0", "parent": "#/body", "page": 1, "bbox": [71.1, 720.1, 264.1, 756.8], "layer": "body", "route": "DIGITAL", "source": "text_layer", "caption": "", "text": "", "status": "kept", "section_path": [], "speaker": "regulator", "study_ids": []}, {"type": "text", "ref": "#/texts/0", "parent": "#/groups/0", "page": 1, "bbox": [72.0, 657.4, 173.5, 682.5], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "BLA 761285/S-004 BLA 761331/S-004", "status": "kept", "furniture": false, "section_path": [], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/1", "parent": "#/groups/1", "page": 1, "bbox": [72.0, 547.0, 315.5, 627.3], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "Amgen Inc. Attention: Augustus Kamassah Director, Global Biosimilars Regulatory Affairs One Amgen Center Drive Mail Stop: 28-4A Thousand Oaks, CA 91320", "status": "kept", "furniture": false, "section_path": [], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/2", "parent": "#/body", "page": 1, "bbox": [72.0, 505.6, 214.9, 516.9], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "section_header", "text": "Dear Augustus Kamassah:", "status": "kept", "furniture": false, "section_path": ["Dear Augustus Kamassah:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/3", "parent": "#/body", "page": 1, "bbox": [72.0, 450.4, 522.4, 489.3], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "Please refer to your supplemental biologics license applications (sBLAs) received March 26, 2025, and your amendments, submitted under section 351(k) of the Public Health Service Act for the following:", "status": "kept", "furniture": false, "section_path": ["Dear Augustus Kamassah:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "table", "ref": "#/tables/0", "parent": "#/body", "page": 1, "bbox": [70.9, 352.4, 540.5, 437.4], "layer": "body", "route": "DIGITAL", "source": "text_layer", "caption": "", "n_rows": 3, "n_cols": 4, "cells": [{"r": 0, "c": 0, "rs": 1, "cs": 1, "text": "Application Number", "header": true, "bbox": [82.4, 422.0, 196.5, 433.6]}, {"r": 0, "c": 1, "rs": 1, "cs": 1, "text": "Product Name", "header": true, "bbox": [238.3, 422.0, 319.8, 433.6]}, {"r": 0, "c": 2, "rs": 1, "cs": 1, "text": "Date of Submission", "header": true, "bbox": [364.2, 408.2, 432.4, 433.6]}, {"r": 0, "c": 3, "rs": 1, "cs": 1, "text": "Date of Receipt", "header": true, "bbox": [471.0, 408.2, 514.5, 433.6]}, {"r": 1, "c": 0, "rs": 1, "cs": 1, "text": "BLA-761285-SUPPL-4", "header": false, "bbox": [77.4, 394.3, 198.2, 405.6]}, {"r": 1, "c": 1, "rs": 1, "cs": 1, "text": "Wezlana (ustekinumab-auub) injection", "header": false, "bbox": [212.4, 380.5, 338.4, 405.6]}, {"r": 1, "c": 2, "rs": 1, "cs": 1, "text": "March 26, 2025", "header": false, "bbox": [356.4, 394.3, 439.9, 405.6]}, {"r": 1, "c": 3, "rs": 1, "cs": 1, "text": "March 26, 2025", "header": false, "bbox": [450.8, 394.3, 534.3, 405.6]}, {"r": 2, "c": 0, "rs": 1, "cs": 1, "text": "BLA-761331-SUPPL-4", "header": false, "bbox": [77.4, 366.2, 198.2, 377.5]}, {"r": 2, "c": 1, "rs": 1, "cs": 1, "text": "Wezlana (ustekinumab-auub) injection", "header": false, "bbox": [212.4, 352.4, 338.4, 377.5]}, {"r": 2, "c": 2, "rs": 1, "cs": 1, "text": "March 26, 2025", "header": false, "bbox": [356.4, 366.2, 439.9, 377.5]}, {"r": 2, "c": 3, "rs": 1, "cs": 1, "text": "March 26, 2025", "header": false, "bbox": [450.8, 366.2, 534.3, 377.5]}], "status": "kept", "section_path": ["Dear Augustus Kamassah:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/4", "parent": "#/body", "page": 1, "bbox": [72.0, 310.5, 439.5, 321.8], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "These Prior Approval supplemental biologics applications provide for:", "status": "kept", "furniture": false, "section_path": ["Dear Augustus Kamassah:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/5", "parent": "#/groups/2", "page": 1, "bbox": [90.0, 268.3, 517.1, 293.4], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "list_item", "text": "Updated branded labeling to align with recent changes to the labeling for USlicensed Stelara approved June 27, 2025.", "status": "kept", "furniture": false, "section_path": ["Dear Augustus Kamassah:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/6", "parent": "#/groups/2", "page": 1, "bbox": [90.0, 239.8, 433.7, 251.1], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "list_item", "text": "Unbranded biological product labeling for Ustekinumab-auub,", "status": "kept", "furniture": false, "section_path": ["Dear Augustus Kamassah:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/7", "parent": "#/groups/2", "page": 1, "bbox": [126.0, 224.2, 266.1, 237.3], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "list_item", "text": "o For subcutaneous use:", "status": "kept", "furniture": false, "section_path": ["Dear Augustus Kamassah:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/8", "parent": "#/groups/2", "page": 1, "bbox": [162.0, 212.2, 360.2, 224.0], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "list_item", "text": " 45 mg/0.5 mL and 90 mg/mL PFS", "status": "kept", "furniture": false, "section_path": ["Dear Augustus Kamassah:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/9", "parent": "#/groups/2", "page": 1, "bbox": [162.0, 198.4, 274.8, 210.2], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "list_item", "text": " 45 mg/0.5 mL vial", "status": "kept", "furniture": false, "section_path": ["Dear Augustus Kamassah:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/10", "parent": "#/groups/2", "page": 1, "bbox": [162.0, 184.6, 393.6, 196.4], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "list_item", "text": " 45 mg/0.5 mL and 90 mg/mL prefilled AI", "status": "kept", "furniture": false, "section_path": ["Dear Augustus Kamassah:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/11", "parent": "#/groups/2", "page": 1, "bbox": [126.0, 169.0, 275.5, 182.1], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "list_item", "text": "o For intravenous infusion:", "status": "kept", "furniture": false, "section_path": ["Dear Augustus Kamassah:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/12", "parent": "#/groups/2", "page": 1, "bbox": [162.0, 157.0, 278.2, 168.8], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "list_item", "text": " 130 mg/26 mL vial", "status": "kept", "furniture": false, "section_path": ["Dear Augustus Kamassah:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/13", "parent": "#/body", "page": 1, "bbox": [388.0, 643.3, 540.0, 654.9], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "section_header", "text": "SUPPLEMENT APPROVAL", "status": "kept", "furniture": false, "section_path": ["SUPPLEMENT APPROVAL"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/14", "parent": "#/body", "page": 1, "bbox": [10.0, 8.3, 92.7, 15.7], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_footer", "text": "Reference ID: 5665958", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/15", "parent": "#/body", "page": 2, "bbox": [72.0, 714.4, 173.5, 753.3], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_header", "text": "BLA 761285/S-004 BLA 761331/S-004 2", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/16", "parent": "#/body", "page": 2, "bbox": [72.0, 677.2, 215.4, 688.9], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "section_header", "text": "APPROVAL & LABELING", "status": "kept", "furniture": false, "section_path": ["APPROVAL & LABELING"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/17", "parent": "#/body", "page": 2, "bbox": [72.0, 622.4, 533.1, 661.3], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "We have completed our review of these applications, as amended. They are approved, effective on the date of this letter, for use as recommended in the enclosed agreedupon labeling.", "status": "kept", "furniture": false, "section_path": ["APPROVAL & LABELING"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/18", "parent": "#/body", "page": 2, "bbox": [72.0, 580.6, 214.7, 592.3], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "section_header", "text": "CONTENT OF LABELING", "status": "kept", "furniture": false, "section_path": ["CONTENT OF LABELING"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/19", "parent": "#/body", "page": 2, "bbox": [72.0, 484.5, 534.3, 564.7], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "As soon as possible, but no later than 14 days from the date of this letter, submit, via the FDA automated drug registration and listing system (eLIST), the content of labeling [21 CFR 601.14(b)] in structured product labeling (SPL) format, as described at FDA.gov, 1 that is identical to the enclosed labeling (text for the Prescribing Information, Instructions for Use, and Medication Guide) and include the labeling changes proposed in any pending \"Changes Being Effected\" (CBE) supplements.", "status": "kept", "furniture": false, "section_path": ["CONTENT OF LABELING"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/20", "parent": "#/body", "page": 2, "bbox": [72.0, 443.0, 503.1, 468.2], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "Information on submitting SPL files using eLIST may be found in the guidance for industry SPL Standard for Content of Labeling Technical Qs and As. 2", "status": "kept", "furniture": false, "section_path": ["CONTENT OF LABELING"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/21", "parent": "#/body", "page": 2, "bbox": [72.0, 415.5, 441.0, 426.8], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "The SPL will be accessible via publicly available labeling repositories.", "status": "kept", "furniture": false, "section_path": ["CONTENT OF LABELING"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/22", "parent": "#/body", "page": 2, "bbox": [72.0, 291.3, 539.0, 399.2], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "Also within 14 days, amend all pending supplemental applications that include labeling changes for this BLA, including pending \"Changes Being Effected\" (CBE) supplements, for which FDA has not yet issued an action letter, with the content of labeling [21 CFR 601.12(f)] in Microsoft Word format that includes the changes approved in this supplemental application, as well as annual reportable changes. To facilitate review of your submission(s), provide a highlighted or marked-up copy that shows all changes, as well as a clean Microsoft Word version. The marked-up copy should provide appropriate annotations, including supplement number(s) and annual report date(s).", "status": "kept", "furniture": false, "section_path": ["CONTENT OF LABELING"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/23", "parent": "#/body", "page": 2, "bbox": [72.0, 249.5, 291.9, 261.2], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "section_header", "text": "CARTON AND CONTAINER LABELING", "status": "kept", "furniture": false, "section_path": ["CARTON AND CONTAINER LABELING"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/24", "parent": "#/body", "page": 2, "bbox": [72.0, 152.9, 537.6, 233.6], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "Submit final printed carton and container labeling that are identical to the enclosed carton and container labeling as soon as they are available, but no more than 30 days after they are printed. Please submit these labeling electronically according to the guidance for industry Providing Regulatory Submissions in Electronic Format - Certain Human Pharmaceutical Product Applications and Related Submissions Using the eCTD Specifications. For administrative purposes, designate this submission \"Final Printed", "status": "kept", "furniture": false, "section_path": ["CARTON AND CONTAINER LABELING"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/25", "parent": "#/body", "page": 2, "bbox": [72.0, 117.9, 456.8, 127.8], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "footnote", "text": "1 http://www.fda.gov/ForIndustry/DataStandards/StructuredProductLabeling/default.htm", "status": "kept", "furniture": false, "section_path": ["CARTON AND CONTAINER LABELING"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/26", "parent": "#/body", "page": 2, "bbox": [72.0, 83.4, 534.4, 104.8], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "footnote", "text": "2 We update guidances periodically. For the most recent version of a guidance, check the FDA Guidance Documents Database https://www.fda.gov/RegulatoryInformation/Guidances/default.htm.", "status": "kept", "furniture": false, "section_path": ["CARTON AND CONTAINER LABELING"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/27", "parent": "#/body", "page": 2, "bbox": [72.0, 47.5, 238.5, 68.3], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_footer", "text": "U.S. Food and Drug Administration Silver Spring, MD 20993", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/28", "parent": "#/body", "page": 2, "bbox": [72.0, 35.6, 133.7, 45.3], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_footer", "text": "www.fda.gov", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/29", "parent": "#/body", "page": 2, "bbox": [10.0, 8.3, 92.7, 15.7], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_footer", "text": "Reference ID: 5665958", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/30", "parent": "#/body", "page": 3, "bbox": [72.0, 742.0, 173.5, 753.3], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_header", "text": "BLA 761285/S-004", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/31", "parent": "#/body", "page": 3, "bbox": [72.0, 728.2, 173.5, 739.5], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_header", "text": "BLA 761331/S-004", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/32", "parent": "#/body", "page": 3, "bbox": [72.0, 714.4, 78.7, 725.7], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_header", "text": "3", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/33", "parent": "#/body", "page": 3, "bbox": [72.0, 650.0, 515.6, 688.9], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "Carton and Container Labeling for approved BLA 761285/S-004 and BLA 761331/S-004.\" Approval of this submission by FDA is not required before the labeling is used.", "status": "kept", "furniture": false, "section_path": ["CARTON AND CONTAINER LABELING"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/34", "parent": "#/body", "page": 3, "bbox": [72.0, 608.2, 297.4, 619.9], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "section_header", "text": "REQUIRED PEDIATRIC ASSESSMENTS", "status": "kept", "furniture": false, "section_path": ["REQUIRED PEDIATRIC ASSESSMENTS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/35", "parent": "#/body", "page": 3, "bbox": [72.0, 512.1, 535.8, 592.3], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "Under the Pediatric Research Equity Act (PREA) (21 U.S.C. 355c), all applications for new active ingredients (which includes new salts and new fixed combinations), new indications, new dosage forms, new dosing regimens, or new routes of administration are required to contain an assessment of the safety and effectiveness of the product for the claimed indication(s) in pediatric patients unless this requirement is waived, deferred, or inapplicable.", "status": "kept", "furniture": false, "section_path": ["REQUIRED PEDIATRIC ASSESSMENTS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/36", "parent": "#/body", "page": 3, "bbox": [72.0, 470.7, 530.4, 495.8], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "At this time, we have determined that no pediatric studies will be required under PREA for your sBLAs.", "status": "kept", "furniture": false, "section_path": ["REQUIRED PEDIATRIC ASSESSMENTS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/37", "parent": "#/body", "page": 3, "bbox": [72.0, 428.9, 243.4, 440.6], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "section_header", "text": "REPORTING REQUIREMENTS", "status": "kept", "furniture": false, "section_path": ["REPORTING REQUIREMENTS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/38", "parent": "#/body", "page": 3, "bbox": [72.0, 387.9, 531.8, 413.0], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "We remind you that you must comply with reporting requirements for an approved BLA (in 21 CFR 600.80 and in 21 CFR 600.81).", "status": "kept", "furniture": false, "section_path": ["REPORTING REQUIREMENTS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/39", "parent": "#/body", "page": 3, "bbox": [72.0, 318.9, 517.7, 371.6], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "Your products are Part 3 combination products (21 CFR 3.2(e)); therefore, you must also comply with postmarketing safety reporting requirements for an approved combination product (21 CFR 4, Subpart B). Additional information on combination product postmarketing safety reporting is available at FDA.gov.", "status": "kept", "furniture": false, "section_path": ["REPORTING REQUIREMENTS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/40", "parent": "#/body", "page": 3, "bbox": [72.0, 263.7, 527.8, 288.8], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "If you have questions, contact Anh-Thy Ly, Project Manager, at 240-402-1001 or AnhThy.Ly@fda.hhs.gov.", "status": "kept", "furniture": false, "section_path": ["REPORTING REQUIREMENTS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/41", "parent": "#/body", "page": 3, "bbox": [279.0, 236.1, 331.8, 247.4], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "Sincerely,", "status": "kept", "furniture": false, "section_path": ["REPORTING REQUIREMENTS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/42", "parent": "#/body", "page": 3, "bbox": [279.0, 208.4, 502.6, 219.8], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "{See appended electronic signature page}", "status": "kept", "furniture": false, "section_path": ["REPORTING REQUIREMENTS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/43", "parent": "#/body", "page": 3, "bbox": [279.0, 111.9, 499.3, 192.2], "layer": "body", "r