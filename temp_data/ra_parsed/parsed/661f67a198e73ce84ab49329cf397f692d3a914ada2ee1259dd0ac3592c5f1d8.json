{"document_id": 142, "sha256": "661f67a198e73ce84ab49329cf397f692d3a914ada2ee1259dd0ac3592c5f1d8", "agency": "fda", "doc_type": "approval_letter", "program_id": "BMAB1200", "engine": "prep-1.4+docling2.137.0+tables-accurate+repair1+pictables1", "watermarks_removed": 0, "routes": [{"page": 1, "route": "DIGITAL", "reason": "chars=119"}, {"page": 2, "route": "IMAGE", "reason": "chars=0 img_cov=1.0"}, {"page": 3, "route": "DIGITAL", "reason": "chars=2818"}, {"page": 4, "route": "DIGITAL", "reason": "chars=2236"}, {"page": 5, "route": "DIGITAL", "reason": "chars=307"}, {"page": 6, "route": "DIGITAL", "reason": "chars=523"}], "blocks": [{"type": "text", "ref": "#/texts/0", "parent": "#/body", "page": 1, "bbox": [95.2, 705.6, 516.8, 750.0], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "section_header", "text": "CENTER FOR DRUG EVALUATION AND RESEARCH", "status": "kept", "furniture": false, "section_path": ["CENTER FOR DRUG EVALUATION AND RESEARCH"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/1", "parent": "#/body", "page": 1, "bbox": [201.7, 643.7, 410.3, 659.1], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "section_header", "text": "APPLICATION NUMBER:", "status": "kept", "furniture": false, "section_path": ["APPLICATION NUMBER:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/2", "parent": "#/body", "page": 1, "bbox": [209.9, 563.2, 402.1, 615.6], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "761406Orig1s000 761406Orig2s000", "status": "kept", "furniture": false, "section_path": ["APPLICATION NUMBER:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/3", "parent": "#/body", "page": 1, "bbox": [153.3, 455.0, 458.6, 475.8], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "section_header", "text": "OTHER ACTION LETTERS", "status": "kept", "furniture": false, "section_path": ["OTHER ACTION LETTERS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "picture", "ref": "#/pictures/0", "parent": "#/body", "page": 2, "bbox": [26.0, 721.0, 217.4, 757.0], "layer": "body", "route": "IMAGE", "source": "ocr", "caption": "", "text": "", "status": "kept", "section_path": ["OTHER ACTION LETTERS"], "speaker": "regulator", "study_ids": []}, {"type": "text", "ref": "#/texts/0", "parent": "#/pictures/0", "page": 2, "bbox": [72.7, 738.0, 95.7, 749.3], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "text", "text": "FDA", "status": "kept", "furniture": false, "section_path": ["OTHER ACTION LETTERS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/1", "parent": "#/pictures/0", "page": 2, "bbox": [98.0, 735.7, 171.0, 753.7], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "text", "text": "U.S. FOOD & DRUG", "status": "reread", "furniture": false, "section_path": ["OTHER ACTION LETTERS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/2", "parent": "#/pictures/0", "page": 2, "bbox": [164.3, 736.3, 220.0, 751.7], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "text", "text": "&DRUG", "status": "kept", "furniture": false, "section_path": ["OTHER ACTION LETTERS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/3", "parent": "#/pictures/0", "page": 2, "bbox": [100.0, 727.0, 179.3, 735.7], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "text", "text": "ADMINISTRATION", "status": "kept", "furniture": false, "section_path": ["OTHER ACTION LETTERS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/4", "parent": "#/body", "page": 2, "bbox": [69.7, 667.3, 193.0, 691.7], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "text", "text": "761406/Original BLA 2", "status": "kept", "furniture": false, "section_path": ["OTHER ACTION LETTERS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/5", "parent": "#/body", "page": 2, "bbox": [69.7, 574.7, 252.7, 645.3], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "text", "text": "Biocon Biologics Inc. Attention: Arlene Wolny Head of Global Regulatory Affairs 245 Main Street, 2nd Floor Cambridge, MA 02142", "status": "kept", "furniture": false, "section_path": ["OTHER ACTION LETTERS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/6", "parent": "#/body", "page": 2, "bbox": [70.3, 534.0, 177.0, 548.0], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "section_header", "text": "Dear Arlene Wolny:", "status": "kept", "furniture": false, "section_path": ["Dear Arlene Wolny:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/7", "parent": "#/body", "page": 2, "bbox": [69.7, 478.0, 528.0, 519.7], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "text", "text": "Please refer to your biologics license application (BLA) dated and received November 29, 2023, and your amendments, submitted under section 351(k) of the Public Health Service (PHS) Act for Yesintek (ustekinumab-kfce) injection.", "status": "kept", "furniture": false, "section_path": ["Dear Arlene Wolny:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/8", "parent": "#/body", "page": 2, "bbox": [70.3, 451.3, 242.0, 465.0], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "section_header", "text": "BLA 761406 seeks licensure of:", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/9", "parent": "#/groups/0", "page": 2, "bbox": [105.7, 394.7, 538.3, 436.0], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "list_item", "text": "Yesintek (ustekinumab-kfce) injection 45 mg/0.5 mL single-dose prefilled syringe for subcutaneous use as interchangeable with Stelara (ustekinumab) injection 45 mg/0.5 mL single-dose prefilled syringe for subcutaneous use,", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/10", "parent": "#/groups/0", "page": 2, "bbox": [106.0, 338.3, 520.7, 380.3], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "list_item", "text": "Yesintek (ustekinumab-kfce) injection 45 mg/0.5 mL single-dose vial for subcutaneous use as interchangeable with Stelara (ustekinumab) injection 45 mg/0.5mL single-dose vial for subcutaneous use,", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/11", "parent": "#/groups/0", "page": 2, "bbox": [105.7, 282.7, 535.0, 324.7], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "list_item", "text": "Yesintek (ustekinumab-kfce) injection 90 mg/mL single-dose prefilled syringe for subcutaneous use as interchangeable with Stelara (ustekinumab) injection mg/mL single-dose prefilled syringe for subcutaneous use, and", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/12", "parent": "#/groups/0", "page": 2, "bbox": [105.7, 226.3, 515.0, 268.3], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "list_item", "text": "Yesintek (ustekinumab-kfce) injection 130 mg/26 mL single-dose vial for intravenous use as interchangeable with Stelara (ustekinumab) injection 130 mg/26 mL single-dose vial for intravenous use.", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/13", "parent": "#/body", "page": 2, "bbox": [69.7, 131.7, 532.7, 212.7], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "text", "text": "This BLA proposes the use of Yesintek (ustekinumab-kfce) injection for adult and pediatric patients 6 years and older with moderate to severe plaque psoriasis (Ps) who are candidates for phototherapy or systemic therapy, adult and pediatric patients 6 years and older with active psoriatic arthritis (PsA), adult patients with moderately to severely active Crohn's disease (CD), and adult patients with moderately to severely active ulcerative colitis.", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/14", "parent": "#/body", "page": 2, "bbox": [70.3, 102.3, 426.7, 116.3], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "text", "text": "For administrative purposes, we have split BLA 761406 as follows:", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/15", "parent": "#/groups/1", "page": 2, "bbox": [89.7, 74.0, 306.0, 88.7], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "list_item", "text": "BLA 761406/Original 1 – biosimilarity ●", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/16", "parent": "#/body", "page": 2, "bbox": [351.0, 657.3, 543.0, 673.7], "layer": "body", "route": "IMAGE", "source": "ocr", "label": "text", "text": "PROVISIONAL DETERMINATION", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/17", "parent": "#/body", "page": 2, "bbox": [7.7, 7.7, 95.0, 19.0], "layer": "furniture", "route": "IMAGE", "source": "ocr", "label": "page_footer", "text": "Reference ID: 5487422", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/0", "parent": "#/body", "page": 3, "bbox": [72.0, 742.0, 192.8, 753.3], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_header", "text": "BLA 761406/Original 2", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/1", "parent": "#/body", "page": 3, "bbox": [72.0, 728.2, 110.1, 739.5], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_header", "text": "Page 2", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/2", "parent": "#/groups/0", "page": 3, "bbox": [90.0, 690.7, 335.5, 702.0], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "list_item", "text": "BLA 761406/Original 2 - interchangeability", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/3", "parent": "#/body", "page": 3, "bbox": [72.0, 649.3, 459.8, 674.4], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "The subject of this correspondence is BLA 761406/Original 2. A separate correspondence was issued for BLA 761406/Original 1.", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/4", "parent": "#/body", "page": 3, "bbox": [72.0, 607.9, 524.4, 633.0], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "All future submissions to these BLAs should specify the BLA number and the Original number to which each submission pertains.", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/5", "parent": "#/body", "page": 3, "bbox": [72.0, 566.5, 495.6, 591.6], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "We have completed a provisional review of this application, as amended. A final determination under sections 351(i) and 351(k) of the PHS Act that:", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/6", "parent": "#/groups/1", "page": 3, "bbox": [90.0, 510.4, 535.6, 549.3], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "list_item", "text": "Yesintek (ustekinumab-kfce) injection 45 mg/0.5 mL single-dose prefilled syringe for subcutaneous use would be interchangeable with Stelara (ustekinumab) injection 45 mg/0.5 mL single-dose prefilled syringe for subcutaneous use", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/7", "parent": "#/groups/1", "page": 3, "bbox": [90.0, 454.4, 538.4, 493.3], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "list_item", "text": "Yesintek (ustekinumab-kfce) injection 45 mg/0.5 mL single-dose vial for subcutaneous use would be interchangeable with Stelara (ustekinumab) injection 45 mg/0.5 mL single-dose vial for subcutaneous use", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/8", "parent": "#/groups/1", "page": 3, "bbox": [90.0, 398.5, 538.4, 437.4], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "list_item", "text": "Yesintek (ustekinumab-kfce) injection 90 mg/mL single-dose prefilled syringe for subcutaneous use would be interchangeable with Stelara (ustekinumab) injection 90 mg/mL single-dose prefilled syringe for subcutaneous use", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/9", "parent": "#/groups/1", "page": 3, "bbox": [90.0, 342.4, 531.0, 381.3], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "list_item", "text": "Yesintek (ustekinumab-kfce) injection 130 mg/26 mL (5 mg/mL) single-dose vial for intravenous use would be interchangeable with Stelara (ustekinumab) injection 130 mg/26 mL (5 mg/mL) single-dose vial for intravenous use", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/10", "parent": "#/body", "page": 3, "bbox": [72.0, 232.0, 528.9, 326.1], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "is currently subject to unexpired exclusivity for the first interchangeable biosimilar biological products, and thus may not be made before the exclusivity has expired. See section 351(k)(6) of the PHS Act. We have not identified any deficiencies that would justify a complete response action at this time; however, we also cannot approve your application because of the unexpired first interchangeable exclusivity. We have therefore provisionally determined that your 351(k) application meets the interchangeability criteria under section 351(k) of the PHS Act.", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/11", "parent": "#/body", "page": 3, "bbox": [72.0, 149.2, 535.7, 215.7], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "This provisional determination is based upon information available to the Agency at this time (i.e., information in your application and that the manufacturing of the biological product complies with the standards established in the BLA as well as the requirements in applicable regulations). This determination is subject to change on the basis of any new information that may come to our attention.", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/12", "parent": "#/body", "page": 3, "bbox": [72.0, 80.2, 531.1, 132.9], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "To obtain approval of this application, submit an amendment no more than six months prior to the date you believe that your application will be eligible for approval. In your cover letter, clearly identify your amendment as \"REQUEST FOR APPROVAL\". This amendment should provide the legal/regulatory basis for your request for approval and should include a copy of any relevant supporting documentation, as appropriate. In addition to a safety update, the amendment should also identify changes, if any, in the application, i.e., updated labeling; chemistry, manufacturing, and controls data; and risk evaluation and mitigation strategy (REMS). If there are no changes, clearly state so in your cover letter. Any changes require our review before approval, and the goal date for our review will be set accordingly.", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/13", "parent": "#/body", "page": 3, "bbox": [72.0, 58.7, 238.5, 68.3], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_footer", "text": "U.S. Food and Drug Administration", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/14", "parent": "#/body", "page": 3, "bbox": [72.0, 47.5, 180.2, 56.8], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_footer", "text": "Silver Spring, MD 20993", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/15", "parent": "#/body", "page": 3, "bbox": [72.0, 35.6, 133.7, 45.3], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_footer", "text": "www.fda.gov", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/16", "parent": "#/body", "page": 3, "bbox": [10.0, 8.3, 92.7, 15.7], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_footer", "text": "Reference ID: 5487422", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/17", "parent": "#/body", "page": 4, "bbox": [72.0, 742.0, 192.8, 753.3], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_header", "text": "BLA 761406/Original 2", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/18", "parent": "#/body", "page": 4, "bbox": [72.0, 728.2, 110.1, 739.5], "layer": "furniture", "route": "DIGITAL", "source": "text_layer", "label": "page_header", "text": "Page 3", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/19", "parent": "#/body", "page": 4, "bbox": [72.0, 512.1, 531.1, 606.1], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "BLA 761406/Original 2 is not approved and Yesintek (ustekinumab-kfce) cannot be legally marketed as an interchangeable biosimilar product unless and until you have been notified in writing that BLA 761406/Original 2 is approved after any necessary additional review. Enclosed are the currently agreed upon labeling (text for the Prescribing Information, Medication Guide, Instructions for Use, Carton and Container labeling). If you believe that there are grounds for issuing the approval letter before the expiration of the exclusivity period, you should amend your application accordingly.", "status": "kept", "furniture": false, "section_path": ["BLA 761406 seeks licensure of:"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/20", "parent": "#/body", "page": 4, "bbox": [72.0, 484.1, 297.4, 495.8], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "section_header", "text": "REQUIRED PEDIATRIC ASSESSMENTS", "status": "kept", "furniture": false, "section_path": ["REQUIRED PEDIATRIC ASSESSMENTS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/21", "parent": "#/body", "page": 4, "bbox": [72.0, 387.9, 535.8, 468.2], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "Under the Pediatric Research Equity Act (PREA) (21 U.S.C. 355c), all applications for new active ingredients (which includes new salts and new fixed combinations), new indications, new dosage forms, new dosing regimens, or new routes of administration are required to contain an assessment of the safety and effectiveness of the product for the claimed indication in pediatric patients unless this requirement is waived, deferred, or inapplicable.", "status": "kept", "furniture": false, "section_path": ["REQUIRED PEDIATRIC ASSESSMENTS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type"