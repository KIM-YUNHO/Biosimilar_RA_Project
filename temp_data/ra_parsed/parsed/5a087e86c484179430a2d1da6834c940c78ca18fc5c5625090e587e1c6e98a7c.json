{"document_id": 223, "sha256": "5a087e86c484179430a2d1da6834c940c78ca18fc5c5625090e587e1c6e98a7c", "agency": "hc", "doc_type": "rds", "program_id": "stelara", "engine": "prep-1.4+docling2.137.0+tables-accurate+repair1+pictables1", "watermarks_removed": 0, "routes": [{"page": 1, "route": "HTML", "reason": "html document"}], "blocks": [{"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "section_header", "text": "Regulatory Decision Summary for Stelara", "level": 1, "ref": "#/html/0", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "section_header", "text": "Review decision", "level": 3, "ref": "#/html/1", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "The Regulatory Decision Summary explains Health Canada’s decision for the product seeking market authorization. The Regulatory Decision Summary includes the purpose of the submission and the reason for the decision.", "ref": "#/html/2", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Product type:", "ref": "#/html/3", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Drug", "ref": "#/html/4", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Medicinal ingredient(s):", "ref": "#/html/5", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Ustekinumab injection", "ref": "#/html/6", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Therapeutic area:", "ref": "#/html/7", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Immunosuppressants", "ref": "#/html/8", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Type of submission:", "ref": "#/html/9", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Supplement to a New Drug Submission", "ref": "#/html/10", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Control number:", "ref": "#/html/11", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "230279", "ref": "#/html/12", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "section_header", "text": "What was the purpose of this submission?", "level": 3, "ref": "#/html/13", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "What was the purpose of this submission?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "The purpose of this submission was to seek an extension of the pediatric plaque psoriasis indication to include patients who are ≥6 to <12 years of age.", "ref": "#/html/14", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "What was the purpose of this submission?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "A Notice of Compliance (NOC) was recommended and issued.", "ref": "#/html/15", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "What was the purpose of this submission?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "section_header", "text": "Why was the decision issued?", "level": 3, "ref": "#/html/16", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Pediatric psoriasis is a chronic disease associated with serious comorbidities. It has a significant impact on a patients quality of life and social functioning. Many treatment options authorized for adults have not been studied in pediatric groups and guidelines as well as treatment algorithms are based on limited evidence in young children. The pharmacokinetics, safety, and efficacy of Stelara was previously studied (CADMUS) in pediatric patients aged ≥12 to <18 years of age with moderate to severe chronic plaque psoriasis to evaluate the safety and efficacy.", "ref": "#/html/17", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "With the CADMUS Jr. Study, the sponsor evaluated the pharmacokinetics, safety, and efficacy of Stelara in the treatment of moderate to severe plaque psoriasis in pediatric patients ≥6 to <12 years of age. This was a phase 3 open label, multicenter study that included patients aged 6 to <12 years of age with a diagnosis of plaque psoriasis for at least 6 months prior to first study drug administration.", "ref": "#/html/18", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "The recommended dosage regimen was identical to the regimen used in CADMUS and was the same as is currently authorized for adolescent plaque psoriasis patients. Following the recommended dosage regimen, the pharmacokinetic profile of ustekinumab in children enrolled in this trial, as assessed by serum trough levels, was considered adequately similar to previous data derived from adolescents ≥12 to <18 years of age.", "ref": "#/html/19", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Efficacy evaluation from the study demonstrated a clinically meaningful improvement from baseline in a majority of patients. At week 12, 77.3% of patients achieved a Physicians Global Assessment (PGA) of clear or minimal suggesting overall improvement and reduction in disease burden. This was also supported by the secondary endpoints that demonstrated 75% and 90% improvements in psoriasis area severity index (PASI) scores from baseline, in 84.1% and 63.6% of patients, respectively. Through the study, 77.3% patients reported one or more adverse events (AEs). The most common events were nasopharyngitis, injection-site erythema, pharyngitis, upper respiratory tract infection, tonsillitis, otitis media, and gastroenteritis. There were no deaths or any reports of malignancy in the study. The safety profile of Stelara was comparable to the adolescent population and no new safety signals were identified in the ≥6 to <12-year-old pediatric population.", "ref": "#/html/20", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "In the management of pediatric plaque psoriasis in patients ≥6 to <12 years of age, Stelara may provide additional options for healthcare practitioners and caregivers. Overall, Stelara is considered to have a favourable benefit/risk profile for treatment of chronic moderate to severe plaque psoriasis in pediatric patients, who are inadequately controlled by, or are intolerant to, other systemic therapies or phototherapies.", "ref": "#/html/21", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "section_header", "text": "Decision issued", "level": 3, "ref": "#/html/22", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Approved; issued a Notice of Compliance in accordance with the Food and Drug Regulations .", "ref": "#/html/23", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Date of decision:", "ref": "#/html/24", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "2020-06-16", "ref": "#/html/25", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Manufacturer:", "ref": "#/html/26", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Janssen Inc.", "ref": "#/html/27", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Drug Identification Numbers issued:", "ref": "#/html/28", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "list_item", "text": "N/A", "ref": "#/html/29", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Prescription status:", "ref": "#/html/30", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Stelara is available by prescription only.", "ref": "#/html/31", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Date filed:", "ref": "#/html/32", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "2019-07-31", "ref": "#/html/33", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Contact:", "ref": "#/html/34", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Date modified:", "ref": "#/html/35", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "2026-10-08", "ref": "#/html/36", "furniture": false, "section_path": ["Regulatory Decision Summary for Stelara", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}], "qa": {"pages": 1, "routes": {"HTML": 1}, "text_blocks": 37, "text_chars": 3799, "ocr_char_share": 0.0, "tables": 0, "tables_ocr_grid": 0, "numeric_cells": 0, "numeric_cell_parse_rate": null, "needs_review_blocks": 0, "reread_blocks": 0, "garbled_residual": 0, "furniture_blocks": 0, "redacted_blocks": 0, "sections": 5}, "timing": {"html": 0.010577917098999023, "total": 0.15645980834960938}}