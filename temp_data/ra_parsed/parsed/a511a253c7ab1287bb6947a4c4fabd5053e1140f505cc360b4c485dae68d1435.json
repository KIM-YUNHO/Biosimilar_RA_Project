{"document_id": 226, "sha256": "a511a253c7ab1287bb6947a4c4fabd5053e1140f505cc360b4c485dae68d1435", "agency": "hc", "doc_type": "rds", "program_id": "stelara", "engine": "prep-1.4+docling2.137.0+tables-accurate+repair1+pictables1", "watermarks_removed": 0, "routes": [{"page": 1, "route": "HTML", "reason": "html document"}], "blocks": [{"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "section_header", "text": "Regulatory Decision Summary for STELARA", "level": 1, "ref": "#/html/0", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "section_header", "text": "Review decision", "level": 3, "ref": "#/html/1", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "The Regulatory Decision Summary explains Health Canada’s decision for the product seeking market authorization. The Regulatory Decision Summary includes the purpose of the submission and the reason for the decision.", "ref": "#/html/2", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Product type:", "ref": "#/html/3", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Drug", "ref": "#/html/4", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Medicinal ingredient(s):", "ref": "#/html/5", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "ustekinumab", "ref": "#/html/6", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Therapeutic area:", "ref": "#/html/7", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Interleukin inhibitor with an immunosuppressant effect.", "ref": "#/html/8", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Type of submission:", "ref": "#/html/9", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Supplement to a New Drug Submission", "ref": "#/html/10", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Control number:", "ref": "#/html/11", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "180654", "ref": "#/html/12", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "section_header", "text": "What was the purpose of this submission?", "level": 3, "ref": "#/html/13", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "What was the purpose of this submission?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "The purpose of this SNDS was to seek market authorization of STELARA for the treatment of moderate to severe plaque psoriasis in adolescent patients from the age of 12 years and older, who are inadequately controlled by, or are intolerant to, other systemic therapies or phototherapies.", "ref": "#/html/14", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "What was the purpose of this submission?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "section_header", "text": "Why was the decision issued?", "level": 3, "ref": "#/html/15", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "The efficacy and safety of STELARA (ustekinumab) were evaluated in a Phase 3, randomized, double blind, placebo-controlled clinical trial conducted in pediatric patients 12 to 17 years of age. The results of this trial showed that treatment with STELARA, compared to placebo, is effective in clearing skin lesions and reducing symptoms related to chronic moderate to severe plaque psoriasis in adolescent patients from 12 to 17 years of age.", "ref": "#/html/16", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "The recommended dose of STELARA ® is based on body weight: 0.75 mg/kg for patients weighing <60 kg, 45 mg for patients weighing between ≥ 60 kg and ≤ 100 kg, and 90 mg for patients weighing >100 kg. STELARA is administered via subcutaneous injection at Weeks 0 and 4, then every 12 weeks thereafter.", "ref": "#/html/17", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "The safety profile of STELARA is this pediatric population is considered comparable to that known in adult patients with the same plaque psoriasis condition. No new safety signals were identified. Therefore, the overall Benefit/Risk of STELARA for the indication authorized above is considered favourable.", "ref": "#/html/18", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "In order to ensure that this benefit continues to outweigh any risk after authorization, Health Canada has required several post-approval activities to be carried out and a Risk Management Plan.", "ref": "#/html/19", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "section_header", "text": "Decision issued", "level": 3, "ref": "#/html/20", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Approved; issued Notice of Compliance in accordance with the Food and Drug Regulations .", "ref": "#/html/21", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Date of decision:", "ref": "#/html/22", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "2015-12-10", "ref": "#/html/23", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Manufacturer:", "ref": "#/html/24", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Janssen Inc.", "ref": "#/html/25", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Drug Identification Numbers issued:", "ref": "#/html/26", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "list_item", "text": "Not Applicable", "ref": "#/html/27", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Prescription status:", "ref": "#/html/28", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "STELARA is available by prescription only.", "ref": "#/html/29", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Date filed:", "ref": "#/html/30", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "2014-12-15", "ref": "#/html/31", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Contact:", "ref": "#/html/32", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "re