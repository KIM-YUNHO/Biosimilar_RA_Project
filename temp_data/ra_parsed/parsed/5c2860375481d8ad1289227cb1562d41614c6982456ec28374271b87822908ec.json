, "text": "Page 4", "status": "kept", "furniture": true, "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/49", "parent": "#/body", "page": 4, "bbox": [72.0, 663.8, 484.2, 688.9], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "product (21 CFR 4, Subpart B). Additional information on combination product postmarketing safety reporting is available at FDA.gov.", "status": "kept", "furniture": false, "section_path": ["REPORTING REQUIREMENTS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/50", "parent": "#/body", "page": 4, "bbox": [72.0, 622.4, 527.8, 647.5], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "If you have questions, contact Anh-Thy Ly, Project Manager, at 240-402-1001 or AnhThy.Ly@fda.hhs.gov.", "status": "kept", "furniture": false, "section_path": ["REPORTING REQUIREMENTS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/51", "parent": "#/body", "page": 4, "bbox": [279.0, 594.8, 331.8, 606.1], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "Sincerely,", "status": "kept", "furniture": false, "section_path": ["REPORTING REQUIREMENTS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/52", "parent": "#/body", "page": 4, "bbox": [279.0, 567.1, 502.6, 578.5], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "{See appended electronic signature page}", "status": "kept", "furniture": false, "section_path": ["REPORTING REQUIREMENTS"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "ref": "#/texts/53", "parent": "#/body", "page": 4, "bbox": [279.0, 470.7, 499.3, 550.9], "layer": "body", "route": "DIGITAL", "source": "text_layer", "label": "text", "text": "Tatiana Oussova, MD, MPH Deputy Director for Sa