"text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Drug", "ref": "#/html/4", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Medicinal ingredient(s):", "ref": "#/html/5", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Ustekinumab", "ref": "#/html/6", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Therapeutic area:", "ref": "#/html/7", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Biologic", "ref": "#/html/8", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Type of submission:", "ref": "#/html/9", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Supplement to a New Drug Submission (SNDS)", "ref": "#/html/10", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Control number:", "ref": "#/html/11", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "190732", "ref": "#/html/12", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Review decision"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "section_header", "text": "What was the purpose of this submission?", "level": 3, "ref": "#/html/13", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "What was the purpose of this submission?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "The purpose of this SNDS submission was to seek approval for the use of STELARA (ustekinumab) for the treatment of moderately to severally active Crohns disease (CD) in patients who failed prior therapies and a new dosage form with 130 mg ustekinumab in 26 mL (5 mg/mL for intravenous injection.", "ref": "#/html/14", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "What was the purpose of this submission?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "STELARA is a fully human immunoglobulin G1 kappa (IgG1k) monoclonal antibody (mAb) that binds with high affinity to human IL-12 and IL-23. This selective immunomodulator was initially authorized by Health Canada for the treatment of psoriasis and Psoriatic Arthritis (PsA).", "ref": "#/html/15", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "What was the purpose of this submission?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "STELARA is indicated for the treatment of adult patients with moderately to severely active Crohns disease, who have had an inadequate response with, loss of response to, or were intolerant to either immunomodulators or one or more tumour necrosis factor-alpha (TNFα) antagonists, or have had an inadequate response, intolerance or demonstrated dependence on corticosteroids.", "ref": "#/html/16", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "What was the purpose of this submission?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "section_header", "text": "Why was the decision issued?", "level": 3, "ref": "#/html/17", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "The benefit of STELARA in patients with moderately to severely active Crohns disease was demonstrated by efficacy data from three phase 3 placebo controlled clinical trials. A significantly higher proportion of patients treated with STELARA achieved clinical response at Week 6 and remission at Week 44 as compared to placebo. In addition, a higher proportion of patients who received STELARA were corticosteroid-free and in clinical remission at Week 44, compared to placebo.", "ref": "#/html/18", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "The overall safety profile of STELARA was similar to that observed in the psoriasis and psoriatic arthritis clinical studies. Serious adverse events will be followed by pharmacovigilance. Post-market safety will be managed with labeling, the on-going open-label, long-term Study IM-UNITI and the Risk Management Plan (RMP) to further evaluate risks associated with the use of ustekinumab.", "ref": "#/html/19", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "In patients who have had an inadequate response with, loss of response to, or were intolerant to prior therapies, STELARA provides alternative treatment options. The benefit is considered to outweigh the risk.", "ref": "#/html/20", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "This submission supports STELARA for the treatment of adult moderate to severe Crohns Disease and is considered to be compliant with section C.08.002 of the Food and Drug Regulations .", "ref": "#/html/21", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Why was the decision issued?"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "section_header", "text": "Decision issued", "level": 3, "ref": "#/html/22", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Approved; issued Notice of Compliance in accordance with the Food and Drug Regulations", "ref": "#/html/23", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "Date of decision:", "ref": "#/html/24", "furniture": false, "section_path": ["Regulatory Decision Summary for STELARA", "Decision issued"], "speaker": "regulator", "redacted": false, "study_ids": []}, {"type": "text", "page": 1, "bbox": null, "layer": "body", "route": "HTML", "source": "html", "status": "kept", "parent": null, "label": "text", "text": "