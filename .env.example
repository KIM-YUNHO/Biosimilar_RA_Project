# Copy to .env (git-ignored) for ra-answer. Variables already set in the environment win.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
RA_LLM_MODEL=gpt-5.6-luna
# sent as reasoning_effort; leave empty for models without the parameter
RA_LLM_REASONING_EFFORT=none
RA_LLM_MAX_OUTPUT=4000
# prompt budget: retrieved evidence is admitted (whole blocks) up to this many tokens
RA_LLM_INPUT_TOKENS=24000
# RA_LLM_TIMEOUT=120
# RA_LLM_RETRIES=2
